+    return (_CORBA_ULong)
+      ((omni::ptr_arith_t)(pd_readonly_and_external_buffer ?
+                           pd_inb_end : pd_outb_mkr) -
+       (omni::ptr_arith_t)pd_bufp_8);
   }
   // Returns the size of the buffer containing valid data.
 
