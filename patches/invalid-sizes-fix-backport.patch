--- a/include/omniORB4/cdrStream.h
+++ b/include/omniORB4/cdrStream.h
@@ -550,6 +550,16 @@ public:
   // Derived classes may provided more efficent implementation than the
   // default.
 
+  inline void copy_to_large(cdrStream& dest, size_t size,
+                            omni::alignment_t align=omni::ALIGN_1)
+  {
+    const size_t batch = 0x7ffffff8;
+    while (size > batch) {
+      copy_to(dest, (int)batch, align);
+      size -= batch;
+    }
+    copy_to(dest, (int)size, align);
+  }
 
   inline void alignInput(omni::alignment_t align)
   // Align the buffer of the input stream to <align>.
@@ -1000,8 +1010,10 @@ public:
 
